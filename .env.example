# StudySphere AI Configuration
# Copy this file to .env and fill in your actual values

# Flask Secret Key (generate a secure random string in production)
SECRET_KEY=dev-secret-key-change-in-production

# Database Path (relative to project root)
DATABASE_PATH=data/studysphere.db

# LLM Provider Configuration
# Local Ollama is the default. OpenAI is optional.
LLM_PROVIDER=ollama

# Ollama local service settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120

# To use OpenAI instead, set LLM_PROVIDER=openai and configure:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=30
